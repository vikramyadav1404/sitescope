# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Free key: Google Cloud Console -> APIs & Services -> enable "PageSpeed Insights API" -> Credentials -> API key
PAGESPEED_API_KEY=
SITE_URL=https://vikramyadav.me
MAX_PAGES=300
# Google Analytics 4 measurement ID (Admin -> Data streams -> Web). Empty = no analytics tag.
GA4_ID=
# Only if you verify Search Console with the HTML tag method (the DNS TXT method needs nothing here)
GSC_VERIFICATION=
# Audits one IP can start per hour (0 = no limit)
AUDITS_PER_IP_PER_HOUR=10
# Email for account confirmation and score-drop alerts (any SMTP provider with STARTTLS on 587).
# Empty SMTP_HOST = accounts still work, but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
